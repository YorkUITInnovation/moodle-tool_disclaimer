{{!
    Template: admin_withdraw_user
    Used by admin_withdraw_user.php — manage disclaimer withdrawal on behalf of users.
}}
<div id="tool-disclaimer-admin-withdraw" data-selected-userid="{{selecteduserid}}">
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">{{#str}}admin_withdraw_search_heading, tool_disclaimer{{/str}}</h5>
            <p class="text-muted">{{#str}}admin_withdraw_search_help, tool_disclaimer{{/str}}</p>
            {{{userform}}}
        </div>
    </div>
    <div id="tool-disclaimer-admin-user-panel" class="d-none">
        <div class="alert alert-secondary" id="tool-disclaimer-admin-user-info"></div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{#str}}admin_withdraw_disclaimers_heading, tool_disclaimer{{/str}}</h5>
                <div id="tool-disclaimer-admin-disclaimer-list">
                    {{! Populated dynamically by AMD }}
                </div>
                <div class="mt-3 d-flex gap-2" id="tool-disclaimer-admin-actions">
                    <button id="tool-disclaimer-admin-withdraw-btn" class="btn btn-danger d-none">
                        {{#str}}withdraw_now, tool_disclaimer{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
