{{!
    @template tool_disclaimer/user_response_action_buttons

    User response action buttons template.

    Context variables required for this template:
    * reset_url - URL for reset action
    * id - Response log ID

    Example context (json):
    {
        "reset_url": "/admin/tool/disclaimer/reset_response.php?id=123",
        "id": 123
    }
}}
<div class="btn-group" role="group" aria-label="{{#str}}actions, tool_disclaimer{{/str}}">
    <a href="{{reset_url}}"
       class="btn btn-warning"
       title="{{#str}}reset_response, tool_disclaimer{{/str}}"
       aria-label="{{#str}}reset_response, tool_disclaimer{{/str}}">
        {{#pix}} t/reset, core {{/pix}}
        <span class="d-none d-md-inline">{{#str}}reset, tool_disclaimer{{/str}}</span>
    </a>
</div>
